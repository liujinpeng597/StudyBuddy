{
  "name": "studybuddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm dev:db\" \"wait-on tcp:5432 && pnpm db:migrate && pnpm --filter @studybuddy/web dev\" \"wait-on tcp:5432 && pnpm --filter @studybuddy/worker dev\"",
    "dev:db": "tsx scripts/dev-pglite.ts",
    "dev:web": "pnpm --filter @studybuddy/web dev",
    "dev:worker": "pnpm --filter @studybuddy/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/seed-test-user.ts && playwright test && pnpm test:e2e:cleanup",
    "infra:up": "docker compose up -d --wait && pnpm storage:init && pnpm db:ensure && pnpm db:migrate",
    "infra:down": "docker compose down",
    "storage:init": "tsx scripts/init-storage.ts",
    "db:ensure": "tsx scripts/init-db.ts",
    "db:generate": "pnpm --filter @studybuddy/db db:generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "env:check": "tsx scripts/check-env.ts",
    "smoke": "tsx scripts/smoke.ts",
    "model:diagnose": "tsx scripts/diagnose-model.ts",
    "jobs:requeue": "tsx scripts/requeue-jobs.ts",
    "knowledge:regroup": "tsx scripts/regroup-knowledge.ts",
    "test:e2e:cleanup": "tsx scripts/cleanup-e2e-user.ts",
    "generate:fixtures": "tsx packages/test-fixtures/generate-leetcode-image.ts",
    "icons:generate": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.4",
    "shiki": "^3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.2.0",
    "pglite-server": "^0.1.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wait-on": "^9.5.1"
  }
}
