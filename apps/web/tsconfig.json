{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@studybuddy/core": ["packages/core/src/index.ts"],
      "@studybuddy/db": ["packages/db/src/index.ts"],
      "@studybuddy/ai": ["packages/ai/src/index.ts"],
      "@studybuddy/storage": ["packages/storage/src/index.ts"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
