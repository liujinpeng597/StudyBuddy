{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": true,
    "baseUrl": "../..",
    "paths": {
      "@studybuddy/core": ["packages/core/src/index.ts"],
      "@studybuddy/db": ["packages/db/src/index.ts"],
      "@studybuddy/ai": ["packages/ai/src/index.ts"],
      "@studybuddy/storage": ["packages/storage/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../packages/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "../../packages/**/*.test.ts"]
}
